PROJECT_NAME="GeoRisk Analytics API"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=georisk
POSTGRES_PASSWORD=georisk_secret
POSTGRES_DB=georisk_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://georisk:georisk_secret@localhost:5432/georisk_db

# Cache Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Origins (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

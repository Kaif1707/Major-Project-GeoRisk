# GeoRisk Analytics Production Environment Configuration
PROJECT_NAME="GeoRisk Analytics"
ENVIRONMENT="production"
VERSION="1.0.0"
DEBUG=False

# API & Security Configuration
SECRET_KEY="georisk_production_jwt_secret_key_2026_super_secure_token"
